<?xml version="1.0"?>
<iq:manifest version="3" xmlns:iq="http://www.garmin.com/xml/connectiq">
    <!-- App id identifies the store listing, not the app. Three listings exist and an id can only
         be claimed once: C80BB06A039F41E3A94EB4D4DF22BAF2 on the personal account,
         B608F363360C46F3AB955E4551BF8B67 on the account the test watch is paired to, and this one,
         the public listing. Every id the manifest has ever shipped under has to stay registered in
         GarminManager.appUUIDs or phone sync fails silently on the older installs. -->
    <iq:application id="837E33EF7DA745A3B0FF02C96840622C"
                    type="watch-app"
                    name="@Strings.AppName"
                    entry="TidalLabsApp"
                    launcherIcon="@Drawables.LauncherIcon"
                    minApiLevel="5.2.0">

        <!-- Two key maps, picked at runtime off DeviceSettings.inputButtons — see
             SurfDelegate. 5-button watches: enter = START/STOP, down = log wave.
             2-button touchscreens (venu*, vivoactive6): enter = START / log wave,
             back = sync. All Edge devices are excluded: not wearable, no touch
             suppression. -->
        <iq:products>
            <iq:product id="d2mach2pro"/>
            <iq:product id="enduro3"/>
            <iq:product id="fenix843mm"/>
            <iq:product id="fenix847mm"/>
            <iq:product id="fenix8pro47mm"/>
            <iq:product id="fenix8solar47mm"/>
            <iq:product id="fenix8solar51mm"/>
            <iq:product id="fenixe"/>
            <iq:product id="fr170"/>
            <iq:product id="fr170m"/>
            <iq:product id="fr57042mm"/>
            <iq:product id="fr57047mm"/>
            <iq:product id="fr70"/>
            <iq:product id="fr970"/>
            <iq:product id="instinct3amoled45mm"/>
            <iq:product id="instinct3amoled50mm"/>
            <iq:product id="instinct3solar45mm"/>
            <iq:product id="instinctcrossoveramoled"/>
            <iq:product id="instincte40mm"/>
            <iq:product id="instincte45mm"/>
            <iq:product id="venu3"/>
            <iq:product id="venu441mm"/>
            <iq:product id="venu445mm"/>
            <iq:product id="venux1"/>
            <iq:product id="vivoactive6"/>
        </iq:products>

        <iq:permissions>
            <iq:uses-permission id="Fit"/>
            <iq:uses-permission id="Positioning"/>
            <iq:uses-permission id="Communications"/>
        </iq:permissions>

        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>

        <iq:barrels/>
    </iq:application>
</iq:manifest>
