project.manifest = manifest.xml

base.resourcePath = resources

# The launcher icon has to be authored at the exact pixel size each device asks for or
# the resource compiler warns and rescales it. Eight sizes cover all twenty-five products,
# and they do not line up with device families, so they are wired per device. The SVG art
# is identical in each folder — only the declared width/height differ.
instinctcrossoveramoled.resourcePath = $(instinctcrossoveramoled.resourcePath);resources-icon38

fenix8solar47mm.resourcePath = $(fenix8solar47mm.resourcePath);resources-icon40
fenix8solar51mm.resourcePath = $(fenix8solar51mm.resourcePath);resources-icon40
enduro3.resourcePath = $(enduro3.resourcePath);resources-icon40

instincte40mm.resourcePath = $(instincte40mm.resourcePath);resources-icon52

fr170.resourcePath = $(fr170.resourcePath);resources-icon54
fr170m.resourcePath = $(fr170m.resourcePath);resources-icon54
fr57042mm.resourcePath = $(fr57042mm.resourcePath);resources-icon54
fr70.resourcePath = $(fr70.resourcePath);resources-icon54
venu441mm.resourcePath = $(venu441mm.resourcePath);resources-icon54
vivoactive6.resourcePath = $(vivoactive6.resourcePath);resources-icon54

fenix843mm.resourcePath = $(fenix843mm.resourcePath);resources-icon60
fenixe.resourcePath = $(fenixe.resourcePath);resources-icon60
instinct3amoled45mm.resourcePath = $(instinct3amoled45mm.resourcePath);resources-icon60
instinct3amoled50mm.resourcePath = $(instinct3amoled50mm.resourcePath);resources-icon60

instinct3solar45mm.resourcePath = $(instinct3solar45mm.resourcePath);resources-icon62
instincte45mm.resourcePath = $(instincte45mm.resourcePath);resources-icon62

fenix847mm.resourcePath = $(fenix847mm.resourcePath);resources-icon65
fenix8pro47mm.resourcePath = $(fenix8pro47mm.resourcePath);resources-icon65
fr57047mm.resourcePath = $(fr57047mm.resourcePath);resources-icon65
fr970.resourcePath = $(fr970.resourcePath);resources-icon65
d2mach2pro.resourcePath = $(d2mach2pro.resourcePath);resources-icon65
venu445mm.resourcePath = $(venu445mm.resourcePath);resources-icon65
venux1.resourcePath = $(venux1.resourcePath);resources-icon65

venu3.resourcePath = $(venu3.resourcePath);resources-icon70

# Button names for the on-screen hints. Instinct calls the upper-right key GPS, not START;
# the two-button touchscreens call it the ACTION button and sync sits on BACK. Everything
# else uses the defaults in resources/strings/strings.xml.
instinct3amoled45mm.resourcePath = $(instinct3amoled45mm.resourcePath);resources-keys-instinct
instinct3amoled50mm.resourcePath = $(instinct3amoled50mm.resourcePath);resources-keys-instinct
instinct3solar45mm.resourcePath = $(instinct3solar45mm.resourcePath);resources-keys-instinct
instinctcrossoveramoled.resourcePath = $(instinctcrossoveramoled.resourcePath);resources-keys-instinct
instincte40mm.resourcePath = $(instincte40mm.resourcePath);resources-keys-instinct
instincte45mm.resourcePath = $(instincte45mm.resourcePath);resources-keys-instinct

venu3.resourcePath = $(venu3.resourcePath);resources-keys-venu
venu441mm.resourcePath = $(venu441mm.resourcePath);resources-keys-venu
venu445mm.resourcePath = $(venu445mm.resourcePath);resources-keys-venu
venux1.resourcePath = $(venux1.resourcePath);resources-keys-venu
vivoactive6.resourcePath = $(vivoactive6.resourcePath);resources-keys-venu
